        "fn": 5
      },
      "n": 1115
    },
    "train": {
      "accuracy": 0.9922,
      "precision": 0.9668,
      "recall": 0.9749,
      "f1": 0.9708,
      "roc_auc": 0.9942,
      "confusion": {
        "tp": 582,
        "fp": 20,
        "tn": 3842,
        "fn": 15
      },
      "n": 4459
    }
  },
  "most_indicative_tokens": [
    "claim",
