{
  "model": "orbis-protect-message-nb",
  "version": "1.0.0",
  "task": "P(scam / unsolicited social-engineering) for a short message",
  "algorithm": "Multinomial Naive Bayes, Laplace alpha=0.5, vocab min count 2, implemented from scratch",
