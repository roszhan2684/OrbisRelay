            "id": "approved_model_low_friction",
            "name": "Approved models stay autonomous",
            "when": {
              "all": [
                {
                  "field": "destination.type",
                  "op": "eq",
                  "value": "internal_model"
                },
                {
                  "field": "destination.approved",
                  "op": "eq",
                  "value": true
                }
              ]
            },
            "effect": "allow_log",
            "reason": "Approved internal model; logged for audit only."
          },
          {
            "id": "restricted_never_external",
            "name": "Restricted data never leaves",
            "when": {
              "all": [
                {
                  "field": "destination.external",
                  "op": "eq",
                  "value": true
                },
                {
                  "field": "resource.classification",
                  "op": "eq",
                  "value": "restricted"
                }
              ]
            },
            "effect": "deny",
            "reason": "Restricted data may not be transmitted outside Northstar under any approval."
          }
        ],
        "change_note": "Draft: auto-allow approved internal model, hard-deny restricted egress",
        "created_at": "2026-10-03T00:00:00.000Z",
        "created_by": "alex.chen"
      }
    ]
  },
  {
    "id": "pol_payments",
    "name": "Payments & payouts",
    "description": "Step-up approval for new beneficiaries and extreme-value payments.",
    "pack": "Finance",
    "enabled": true,
    "current_version": 9,
    "versions": [
      {
        "policy_id": "pol_payments",
        "version": 8,
        "status": "superseded",
        "rules": [
          {
            "id": "new_beneficiary_high",
            "name": "New beneficiary over $10k",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "payment"
                },
                {
                  "field": "amount_usd",
                  "op": "gte",
                  "value": 10000
                },
                {
                  "field": "destination.approved",
                  "op": "neq",
                  "value": true
                }
              ]
            },
            "effect": "require_approval",
            "reason": "First payment to an unverified beneficiary above the $10,000 autonomous threshold.",
            "route": "finance-controller",
            "step_up": "biometric",
            "editable_fields": [
              {
                "key": "amount_usd",
                "label": "Amount (USD)",
                "type": "number",
                "min": 0
              }
            ],
            "safe_alternatives": [
              {
                "id": "verify_then_pay",
                "type": "reduce_scope",
                "label": "Pay $1 verification deposit first",
                "description": "Confirm beneficiary bank details with a $1 micro-deposit before releasing funds.",
                "apply": {
                  "amount_usd": 1,
                  "hold_remaining": true
                }
              }
            ]
          }
        ],
        "change_note": "Initial beneficiary rule",
        "created_at": "2026-07-13T00:00:00.000Z",
        "created_by": "jordan.patel",
        "published_at": "2026-07-13T00:00:00.000Z"
      },
      {
        "policy_id": "pol_payments",
        "version": 9,
        "status": "published",
        "rules": [
          {
            "id": "new_beneficiary_high",
            "name": "New beneficiary over $10k",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "payment"
                },
                {
                  "field": "amount_usd",
                  "op": "gte",
                  "value": 10000
                },
                {
                  "field": "destination.approved",
                  "op": "neq",
                  "value": true
                }
              ]
            },
            "effect": "require_approval",
            "reason": "First payment to an unverified beneficiary above the $10,000 autonomous threshold.",
            "route": "finance-controller",
            "step_up": "biometric",
            "editable_fields": [
              {
                "key": "amount_usd",
                "label": "Amount (USD)",
                "type": "number",
                "min": 0
              }
            ],
            "safe_alternatives": [
              {
                "id": "verify_then_pay",
                "type": "reduce_scope",
                "label": "Pay $1 verification deposit first",
                "description": "Confirm beneficiary bank details with a $1 micro-deposit before releasing funds.",
                "apply": {
                  "amount_usd": 1,
                  "hold_remaining": true
                }
              }
            ]
          },
          {
            "id": "extreme_payment_quorum",
            "name": "Payments ≥ $250k need two controllers",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "payment"
                },
                {
                  "field": "amount_usd",
                  "op": "gte",
                  "value": 250000
                }
              ]
            },
            "effect": "require_quorum",
            "quorum": {
              "required": 2,
              "of": 3
            },
            "reason": "Extreme-value payment requires two of three authorized controllers.",
            "route": "finance-controller",
            "step_up": "biometric"
          },
          {
            "id": "known_vendor_small",
            "name": "Known vendors under $10k",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "payment"
                },
                {
                  "field": "amount_usd",
                  "op": "lt",
                  "value": 10000
                },
                {
                  "field": "destination.approved",
                  "op": "eq",
                  "value": true
                }
              ]
            },
            "effect": "allow_log",
            "reason": "Routine payment to a verified vendor."
          }
        ],
        "change_note": "Add quorum for ≥ $250k and auto-allow known vendors",
        "created_at": "2026-08-30T00:00:00.000Z",
        "created_by": "jordan.patel",
        "published_at": "2026-08-30T00:00:00.000Z"
      }
    ]
  },
  {
    "id": "pol_refunds",
    "name": "Customer refunds",
    "description": "Keeps support automation fast for small refunds, escalates large ones.",
    "pack": "Support",
    "enabled": true,
    "current_version": 5,
    "versions": [
      {
        "policy_id": "pol_refunds",
        "version": 5,
        "status": "published",
        "rules": [
          {
            "id": "refund_over_threshold",
            "name": "Refund above $2,500",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "refund"
                },
                {
                  "field": "amount_usd",
                  "op": "gt",
                  "value": 2500
                }
              ]
            },
            "effect": "require_approval",
            "reason": "Refund exceeds the $2,500 autonomous support threshold.",
            "route": "support-manager",
            "step_up": "none",
            "editable_fields": [
              {
                "key": "amount_usd",
                "label": "Refund amount (USD)",
                "type": "number",
                "min": 0,
                "max": 50000
              }
            ],
            "safe_alternatives": [
              {
                "id": "service_credit",
                "type": "reduce_scope",
                "label": "Issue as service credit",
                "description": "Apply the amount as account credit instead of a card refund.",
                "apply": {
                  "method": "service_credit"
                }
              }
            ]
          },
          {
            "id": "refund_warn",
            "name": "Refund $500–$2,500",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "refund"
                },
                {
                  "field": "amount_usd",
                  "op": "gt",
                  "value": 500
                }
              ]
            },
            "effect": "warn",
            "reason": "Refund above $500 — allowed, support lead notified."
          },
          {
            "id": "refund_hard_cap",
            "name": "Refund hard cap",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "refund"
                },
                {
                  "field": "amount_usd",
                  "op": "gt",
                  "value": 50000
                }
              ]
            },
            "effect": "deny",
            "reason": "Refunds above $50,000 must go through finance, not support automation."
          }
        ],
        "change_note": "Raise autonomous threshold to $2,500",
        "created_at": "2026-09-09T00:00:00.000Z",
        "created_by": "sam.rivera",
        "published_at": "2026-09-09T00:00:00.000Z"
      }
    ]
  },
  {
    "id": "pol_prod_change",
    "name": "Production change control",
    "description": "Change-window enforcement for production deploys.",
    "pack": "Engineering",
    "enabled": true,
    "current_version": 12,
    "versions": [
      {
        "policy_id": "pol_prod_change",
        "version": 11,
        "status": "superseded",
        "rules": [
          {
            "id": "prod_outside_window",
            "name": "Production deploy outside change window",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "deploy"
                },
                {
                  "field": "resource.environment",
                  "op": "eq",
                  "value": "production"
                },
                {
                  "field": "signals.outside_change_window",
                  "op": "eq",
                  "value": true
                }
              ]
            },
            "effect": "require_approval",
            "reason": "Production change requested outside the approved change window.",
            "route": "eng-oncall",
            "step_up": "biometric",
            "editable_fields": [
              {
                "key": "window_minutes",
                "label": "Change window (minutes)",
                "type": "duration_minutes",
                "min": 5,
                "max": 60
              }
            ],
            "safe_alternatives": [
              {
                "id": "next_window",
                "type": "schedule",
                "label": "Schedule for next change window",
                "description": "Queue the deploy for the 02:00 UTC window with automatic rollback armed.",
                "apply": {
                  "scheduled_for": "next_window"
                }
              }
            ]
          },
          {
            "id": "prod_failing_tests",
            "name": "Block deploys with failing tests",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "deploy"
                },
                {
                  "field": "resource.environment",
                  "op": "eq",
                  "value": "production"
                },
                {
                  "field": "signals.tests_passed",
                  "op": "eq",
                  "value": false
                }
              ]
            },
            "effect": "deny",
            "reason": "Required checks are failing; production deploy is blocked."
          },
          {
            "id": "prod_in_window",
            "name": "In-window production deploys",
            "when": {
              "all": [
                {
                  "field": "action.type",
                  "op": "eq",
                  "value": "deploy"
                },
                {
                  "field": "resource.environment",
                  "op": "eq",
                  "value": "production"
                },
                {
                  "field": "signals.outside_change_window",
                  "op": "neq",
                  "value": true
                }
              ]
            },
            "effect": "warn",
            "reason": "Deploy inside an approved change window."
          }
        ],
        "change_note": "Warn on in-window deploys",
        "created_at": "2026-07-31T00:00:00.000Z",
        "created_by": "riley.okafor",
        "published_at": "2026-07-31T00:00:00.000Z"
      },
