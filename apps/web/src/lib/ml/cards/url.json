      "free_hosting",
      "brand_impersonation",
      "keyword",
      "tld_length",
      "sld_length"
    ],
    "sparse": "65536 FNV-1a hashed char 3/4/5-grams + TLD token"
  },
  "data": {
    "sources": [
      {
        "name": "PhiUSIIL Phishing URL Dataset",
        "url": "https://archive.ics.uci.edu/dataset/967/phiusiil+phishing+url+dataset",
        "license": "CC BY 4.0"
      },
      {
        "name": "Tranco top sites list (647LX)",
        "url": "https://tranco-list.eu/list/647LX",
