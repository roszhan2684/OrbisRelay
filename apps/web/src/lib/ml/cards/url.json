{
  "model": "orbis-protect-hostname-lr",
  "version": "1.0.0",
  "task": "P(phishing) for a URL hostname (scheme and leading www. removed)",
  "algorithm": "Logistic regression, full-batch Adam, L2=3e-4, class-balanced, implemented from scratch in numpy",
  "features": {
    "dense": [
      "length",
      "labels",
      "digit_ratio",
      "hyphens",
      "is_ip",
      "entropy",
      "longest_label",
      "punycode",
